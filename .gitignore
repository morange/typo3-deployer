# Never commit project-specific secrets or host data into this public repo.
# These belong in each consuming project, not here.
.hosts.yml
.hosts.yaml
.env
.env.*
!.env.example

# Tooling / OS
/vendor/
composer.lock
.idea/
.vscode/
.DS_Store

# Local working notes / project memory — never committed.
/Projektdateien/

# OpenSpec planning — proposals/tasks reference real consuming-project
# names and incidents, which must never appear in this public repo.
/openspec/

# Local Claude Code tooling (commands/skills) — not part of the package.
/.claude/